# Required: Claude API key for the executive assistant agent
ANTHROPIC_API_KEY=

# Optional: Supabase persistence (without these the app runs on an in-memory demo store)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Gmail access (without these the agent uses a sample inbox)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Protects the API routes and the cron endpoint. Set in production.
APP_SECRET=
CRON_SECRET=

# Your name and context the assistant should know about you
EXEC_NAME=Dan
EXEC_CONTEXT=Founder running Event Revenue OS. Priorities: sponsor revenue, ticket sales, key partners.
