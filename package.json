{
  "name": "revos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RevOS — connective revenue layer for live-event businesses (pilot)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --run dev:server & node --run dev:web",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.json --noEmit",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed:fixture": "tsx --env-file-if-exists=.env scripts/seed-fixture.ts",
    "user": "tsx --env-file-if-exists=.env scripts/user.ts",
    "setup:live": "tsx --env-file-if-exists=.env scripts/setup-live.ts",
    "sync": "tsx --env-file-if-exists=.env scripts/sync.ts",
    "reconcile:compare": "tsx --env-file-if-exists=.env scripts/compare-report.ts",
    "check:secrets": "tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
