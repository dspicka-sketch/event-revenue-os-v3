# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# PostgreSQL connection for the app and for tests.
DATABASE_URL=postgres://revos:CHANGE_ME@127.0.0.1:5432/revos_dev
TEST_DATABASE_URL=postgres://revos:CHANGE_ME@127.0.0.1:5432/revos_test

# Server
HOST=127.0.0.1
PORT=8787
# Comma-separated browser origins allowed to call the API cross-origin, e.g. the
# mobile web preview (http://localhost:8081). Native apps don't need this.
REVOS_CORS_ORIGINS=

# Sign-in uses per-user accounts (npm run user -- create ...). Serve over HTTPS
# (reverse proxy) before exposing the server beyond this machine.

# Eventbrite (read-only, live pilot). The database stores only the NAME of this
# variable (secret reference), never the token value.
EVENTBRITE_TOKEN=
# Eventbrite organization ID that owns the pilot event.
EVENTBRITE_ORGANIZATION_ID=
# Eventbrite event ID of the pilot performance.
EVENTBRITE_EVENT_ID=
