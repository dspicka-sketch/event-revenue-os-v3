# Names and setup notes only. Never commit values.

# --- Supabase (dedicated project for Protect 104; not shared with other apps) ---
NEXT_PUBLIC_SUPABASE_URL=            # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # publishable/anon key; RLS protects data
DATABASE_URL=                        # server-only Postgres connection (pooler) used by the agent worker
DATABASE_CA_CERT=                    # optional: Supabase CA PEM for full TLS verification

# --- Durable worker ---
CRON_SECRET=                         # random string; Vercel Cron sends it as a Bearer token

# --- Agent model (optional; runs are blocked with a clear message when unset) ---
AGENT_MODEL=                         # Vercel AI Gateway model id, chosen after evaluation
AI_GATEWAY_API_KEY=                  # not needed on Vercel when OIDC is available
AGENT_PRICE_INPUT_PER_MTOK=          # optional, for *estimated* cost display only
AGENT_PRICE_OUTPUT_PER_MTOK=

# --- Demo (local only; refuses to start alongside Supabase credentials) ---
DEMO_MODE=                           # set to 1 for the isolated synthetic demo
